{
	"create_consumer": {
		"type": "object",
		"properties": {
			"bootstrap_servers": {
				"type": "array",
				"minItems": 1
			},
			"group_id": {
				"type": "string"
			},
			"fetch_max_wait_ms": {
				"type": "integer",
				"minimum": 0
			},
			"fetch_max_bytes": {
				"type": "integer",
				"minimum": 0
			},
			"auto_offset_reset": {
				"type": "boolean"
			},
			"enable_auto_commit": {
				"type": "boolean"
			},
			"max_poll_records": {
				"type": "string",
				"minimum": 1
			}
		},
		"required": ["bootstrap_servers"]
	},

	"subscribe": {
		"type": "object",
		"properties": {
			"topics": {
				"type": "array",
				"items": {
					"type": "string",
					"minLength": 1
				},
				"minItems": 1,
				"uniqueItems": true
			}
		},
		"required": ["topics"]
	},

	"seek_to_end": {
		"type": "object",
		"properties": {
			"topic-partitions": {
				"type": "array",
				"items": {
					"type": "object",
					"properties": {
						"topic": {
							"type": "string",
							"minLength": 1
						},
						"partition": {
							"type": "integer",
							"minimum": 0
						}
					},
					"required": ["topic", "partition"]
				}
			}
		}
	},

	"seek_to_beginning": {
		"type": "object",
		"properties": {
			"topic-partitions": {
				"type": "array",
				"items": {
					"type": "object",
					"properties": {
						"topic": {
							"type": "string",
							"minLength": 1
						},
						"partition": {
							"type": "integer",
							"minimum": 0
						}
					},
					"required": ["topic", "partition"]
				}
			}
		}
	},


	"assign": {
		"type": "object",
		"properties": {
			"topic-partitions": {
				"type": "array",
				"items": {
					"type": "object",
					"properties": {
						"topic": {
							"type": "string",
							"minLength": 1
						},
						"partition": {
							"type": "integer",
							"minimum": 0
						}
					},
					"required": ["topic", "partition"]
				},
				"minItems": 1
			}
		}
	},

	"commit_async": {
		"type": "object",
		"properties": {
			"topic_offset_metadata": {
				"type": "array",
				"items":{ 
					"type": "object",
					"properties": {
						"key": {
							"type": "object",
							"properties": {
								"topic": {
									"type": "string",
									"minLength": 1
								},
								"partition": {
									"type": "integer",
									"minimum": 0
								}
							},
							"required": ["topic", "partition"]
						},
						"value": {
							"type": "object",
							"properties": {
								"offset": {
									"type": "integer"
								},
								"metadata": {
									"type": "string"
								}
							},
							"required": ["offset", "metadata"]
						}
					}
				}
			}
		}
	},

	"commit": {
		"type": "object",
		"properties": {
			"topic_offset_metadata": {
				"type": "array",
				"items":{ 
					"type": "object",
					"properties": {
						"key": {
							"type": "object",
							"properties": {
								"topic": {
									"type": "string",
									"minLength": 1
								},
								"partition": {
									"type": "integer",
									"minimum": 0
								}
							},
							"required": ["topic", "partition"]
						},
						"value": {
							"type": "object",
							"properties": {
								"offset": {
									"type": "integer"
								},
								"metadata": {
									"type": "string"
								}
							},
							"required": ["offset", "metadata"]
						}
					}
				}
			}
		}
	},

	"committed": {
		"type": "object",
		"properties": {
			"topic_partition": {
				"type": "object",
				"properties": {
					"topic": {
						"type": "string",
						"minLength": 1
					},
					"partition": {
						"type": "integer",
						"minimum": 0
					}
				},
				"required": ["topic", "partition"]
			},
			"metadata": {
				"type": "boolean"
			}
		},
		"required": ["topic_partition"]
	}
}

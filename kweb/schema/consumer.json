{
	"create_consumer": {
		"bootstrap_servers": "array",
		"group_id": "string",
		"fetch_max_wait_ms": "integer",
		"fetch_max_bytes": "integer",
		"auto_offset_reset": "boolean",
		"enable_auto_commit": "boolean",
		"max_poll_records": "integer",
		"required": ["bootstrap_servers"]
	},

	"subscribe": {
		"topics": "array",
		"items": {
			"type": "string"
		},

		"required": ["topics"]
	},

	"seek_to_end": {
		"topic-partitions": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"topic": {
						"type": "string"
					},
					"partition": {
						"type": "integer"
					}
				},
				"required": ["topic", "partition"]
			}
		}
	},

	"seek_to_beginning": {
		"topic-partitions": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"topic": {
						"type": "string"
					},
					"partition": {
						"type": "integer"
					}
				},
				"required": ["topic", "partition"]
			}
		}
	},


	"assign": {
		"topic-partitions": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"topic": {
						"type": "string"
					},
					"partition": {
						"type": "integer"
					}
				},
				"required": ["topic", "partition"]
			}
		}
	}
}
